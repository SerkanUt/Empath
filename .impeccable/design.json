  "narrative": {
    "northStar": "The Colour Verdict",
    "overview": "The build is a near-black room (ground #0d0d12) in which the only saturated things are emotions. Chrome, type and controls are white and soft grey; every saturated field on screen is data. The Results screen is the centre of gravity: video at left, two rows of flat emotion cards sharing one time axis and one white playhead, with a Landed / Missed strip between them.\n\nThe voice is casual and plain, but the surface is disciplined: flat colour fields, ink-dark text on them, soft real shadows, no gradients in the authored CSS. Colour is data encoding: each emotion has one hex, one fixed shape, and a text label.",
    "keyCharacteristics": [
      "Dark ground, light chrome, saturated emotion fields as the only colour.",
      "Pill-shaped controls, rounded rectangles for content, a large radius on video.",
      "Flat fills with one soft shadow; depth by tonal layering of three dark surfaces.",
      "Tabular numerals globally; huge heavy score numeral as the single display moment.",
      "Every emotion mark = colour + shape + label."
    ],
    "rules": [
      {
        "name": "The Three-Signal Rule",
        "body": "An emotion is never colour alone: hex from EMOTION_COLORS, path from EMOTION_SHAPES, and its name in text.",
        "section": "colors"
      },
      {
        "name": "The Saturation Is Data Rule",
        "body": "Saturated hues on screen mean an emotion. Chrome stays white and grey.",
        "section": "colors"
      },
      {
        "name": "The Ink-On-Colour Rule",
        "body": "Text and marks on an emotion fill are ink, never white.",
        "section": "colors"
      },
      {
        "name": "The Heavy-Or-Plain Rule",
        "body": "Headings and numerals go to 800-900; everything else stays at 400-700.",
        "section": "typography"
      },
      {
        "name": "The Name Beats Size Rule",
        "body": "In narrow cards the name rotates to vertical text at 13px rather than dropping.",
        "section": "typography"
      },
      {
        "name": "The Soft Shadow Only Rule",
        "body": "Shadows are blurred and dark; no offset, hard or coloured shadows.",
        "section": "elevation"
      },
      {
        "name": "The Flat Fill Rule",
        "body": "Emotion fields are single flat colours. No gradients on emotion colours.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pair every emotion colour with its fixed shape and a text label.",
      "Do use ink (#14141c) for text and marks on emotion fills.",
      "Do keep chrome white and grey so saturated colour always means an emotion.",
      "Do read colours from EMOTION_COLORS / --e-*; read shapes from EMOTION_SHAPES.",
      "Do use pills for buttons and tabs, 16px for emotion cards, 24px for video.",
      "Do make Landed and Missed legible without colour (word plus solid vs dashed rule).",
      "Do keep the webcam preview small (220px) and quiet during Watch."
    ],
    "donts": [
      "Don't use an emotion colour for decoration or branding; it reads as data.",
      "Don't use gradients, hard offset shadows, or coloured shadows.",
      "Don't put white text on an emotion fill.",
      "Don't mix a second typeface or intermediate display weights.",
      "Don't build a generic analytics dashboard of stat tiles; the comparison is the two-lane card graph."
    ]
  }
}